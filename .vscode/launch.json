{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome/Edge against localhost",
      "type": "chrome", // 或者 "msedge"
      "request": "launch",
      "url": "http://localhost:5500", // 你的本地开发服务器地址
      "webRoot": "${workspaceFolder}",
      // 👇 添加这几行来忽略内部扩展的 source map 警告
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ]
}